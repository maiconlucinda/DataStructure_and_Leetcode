      "id": "el_1089",
      "type": "text",
      "x": 15,
      "y": 3015,
      "width": 504.59999999999997,
      "height": 281.25,
      "text": "ARRAY = caixinhas na memoria, acessadas por INDICE\n            |\nINDICE = um numero inteiro guardado numa variavel\n            |\nPONTEIRO = apelido para 'variavel que guarda um indice'\n            |\nMOVER PONTEIRO = somar ou subtrair 1 dessa variavel\n            |\nFOR = move automatico (+1 sempre)\nWHILE = voce move na mao (quando quiser, pra onde quiser)\n            |\nDOIS PONTEIROS = duas variaveis + while + if pra decidir\n                 qual mover a cada passo\n            |\nDE TRAS PRA FRENTE = comece pelo lado que tem espaco livre",
      "originalText": "ARRAY = caixinhas na memoria, acessadas por INDICE\n            |\nINDICE = um numero inteiro guardado numa variavel\n            |\nPONTEIRO = apelido para 'variavel que guarda um indice'\n            |\nMOVER PONTEIRO = somar ou subtrair 1 dessa variavel\n            |\nFOR = move automatico (+1 sempre)\nWHILE = voce move na mao (quando quiser, pra onde quiser)\n            |\nDOIS PONTEIROS = duas variaveis + while + if pra decidir\n                 qual mover a cada passo\n            |\nDE TRAS PRA FRENTE = comece pelo lado que tem espaco livre",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    }
