      "x": 0,
      "y": 680,
      "width": 487.2,
      "height": 30.0,
      "text": "2) O QUE E UM INDICE (o 'ponteiro')",
      "originalText": "2) O QUE E UM INDICE (o 'ponteiro')",
      "fontSize": 24,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "angle": 0,
