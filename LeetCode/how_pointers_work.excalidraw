      "x": 30,
      "y": 2560,
      "width": 400.2,
      "height": 56.25,
      "text": "posicao [0] <- escrevo aqui... mas JA TEM o A!\nPreciso mover o A antes. E o B. E o C.\nTrabalho extra. Risco de perder dados.",
      "originalText": "posicao [0] <- escrevo aqui... mas JA TEM o A!\nPreciso mover o A antes. E o B. E o C.\nTrabalho extra. Risco de perder dados.",
