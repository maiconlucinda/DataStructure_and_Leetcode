      "width": 482.55999999999995,
      "height": 160.0,
      "text": "left = 0              # ponteiro 1: comeca no INICIO\nright = 4             # ponteiro 2: comeca no FIM\n\nwhile left < right:   # enquanto nao se cruzarem\n    if (condicao A):\n        left += 1     # <<< so o left anda\n    else:\n        right -= 1    # <<< so o right anda",
      "originalText": "left = 0              # ponteiro 1: comeca no INICIO\nright = 4             # ponteiro 2: comeca no FIM\n\nwhile left < right:   # enquanto nao se cruzarem\n    if (condicao A):\n        left += 1     # <<< so o left anda\n    else:\n        right -= 1    # <<< so o right anda",
      "fontSize": 16,
