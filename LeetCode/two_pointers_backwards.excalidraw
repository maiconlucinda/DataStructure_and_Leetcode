      "link": null,
      "locked": false,
      "id": "el_1103",
      "type": "text",
      "x": 0,
      "y": 1325,
      "width": 616.0,
      "height": 40.0,
      "text": "Nao existe 'ponteiro magico'. Sao apenas 3 variaveis guardando NUMEROS\n(indices). Mover um ponteiro = mudar o numero guardado numa variavel.",
      "originalText": "Nao existe 'ponteiro magico'. Sao apenas 3 variaveis guardando NUMEROS\n(indices). Mover um ponteiro = mudar o numero guardado numa variavel.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
