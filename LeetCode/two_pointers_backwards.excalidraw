      "locked": false,
      "id": "el_1104",
      "type": "text",
      "x": 0,
      "y": 1380,
      "width": 519.2,
      "height": 20.0,
      "text": "m    = indice do ultimo valor real de nums1   (comeca em 2)",
      "originalText": "m    = indice do ultimo valor real de nums1   (comeca em 2)",
      "fontSize": 16,
      "fontFamily": 1,
