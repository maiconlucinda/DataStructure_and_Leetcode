      "type": "text",
      "x": 130,
      "y": 1170,
      "width": 554.4000000000001,
      "height": 20.0,
      "text": "3 vs 6  ->  6 e maior  ->  escrevo 6 no 'last'. So o 'n' recua.",
      "originalText": "3 vs 6  ->  6 e maior  ->  escrevo 6 no 'last'. So o 'n' recua.",
      "fontSize": 16,
      "fontFamily": 1,
