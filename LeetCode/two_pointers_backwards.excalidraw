      "type": "text",
      "x": 0,
      "y": 1280,
      "width": 567.6,
      "height": 30.0,
      "text": "4) COMO O COMPUTADOR FAZ (o mecanismo real)",
      "originalText": "4) COMO O COMPUTADOR FAZ (o mecanismo real)",
      "fontSize": 24,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
